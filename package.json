{
  "name": "@kubohiroya/turbowarp-app-template",
  "version": "0.6.1",
  "private": false,
  "type": "module",
  "description": "Reusable SB3 source and app shell scaffold for TurboWarp applications.",
  "license": "MPL-2.0",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-app-template.git"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run build:sb3 && vite build",
    "build:sb3": "node scripts/build-sb3.ts",
    "lint": "eslint src scripts config tests vite.config.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run build",
    "template:init": "node scripts/init-app.ts",
    "build:cli": "tsc -p tsconfig.cli.json && node scripts/copy-cli-assets.mjs",
    "prepack": "pnpm check && pnpm build:cli && node scripts/check-package.mjs && pnpm test:release",
    "pack:check": "pnpm check && pnpm build:cli && node scripts/check-package.mjs && pnpm test:release",
    "test:release": "node --test scripts/verify-release.mjs"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-app-shell": "^0.6.1"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "^0.30.0",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "prettier": "3.9.6"
  },
  "bin": {
    "create-turbowarp-app": "./dist/init-app.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".github/workflows/ci.yml",
    ".gitignore",
    "config/",
    "src/",
    "scripts/",
    "tests/",
    "dist/init-app.js",
    "dist/readme.js",
    "tsconfig.json",
    "tsconfig.cli.json",
    "vite.config.ts",
    "eslint.config.js",
    "eslint.config.mjs",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "dist/template.gitignore"
  ]
}
